  "components": [
    {
      "name": "PLAY Button (dusk)",
      "kind": "button",
      "refersTo": "play-button-dusk",
      "description": "The single call to action, on the lead Fischdex entry only; links to the live game.",
      "html": "<a class=\"ds-play-dusk\" href=\"#\"><svg width=\"16\" height=\"28\" viewBox=\"0 0 4 7\" shape-rendering=\"crispEdges\" aria-hidden=\"true\"><path d=\"M0 0h1v7h-1zM1 1h1v5h-1zM2 2h1v3h-1zM3 3h1v1h-1z\" fill=\"currentColor\"/></svg><span>PLAY</span></a>",
      "css": ".ds-play-dusk{display:inline-flex;align-items:center;gap:12px;height:60px;padding:0 28px 0 20px;background:#ff7a3d;color:#1b1430;box-shadow:4px 4px 0 #f4ecd8;border-radius:0;text-decoration:none;font-size:28px;font-family:'Press Start 2P',ui-monospace,monospace;text-transform:uppercase;letter-spacing:0;}.ds-play-dusk:hover{background:#ffd36b}.ds-play-dusk:focus-visible{outline:4px solid #ffd36b;outline-offset:4px}.ds-play-dusk:active{transform:translate(4px,4px);box-shadow:none}"
    },
    {
      "name": "PLAY Button (midday)",
      "kind": "button",
      "refersTo": "play-button-midday",
      "description": "The same call to action in the midday light: rust face, cream label, ink drop.",
      "html": "<a class=\"ds-play-midday\" href=\"#\"><svg width=\"16\" height=\"28\" viewBox=\"0 0 4 7\" shape-rendering=\"crispEdges\" aria-hidden=\"true\"><path d=\"M0 0h1v7h-1zM1 1h1v5h-1zM2 2h1v3h-1zM3 3h1v1h-1z\" fill=\"currentColor\"/></svg><span>PLAY</span></a>",
      "css": ".ds-play-midday{display:inline-flex;align-items:center;gap:12px;height:60px;padding:0 28px 0 20px;background:#c4541a;color:#f4ecd8;box-shadow:4px 4px 0 #1b1430;border-radius:0;text-decoration:none;font-size:28px;font-family:'Press Start 2P',ui-monospace,monospace;text-transform:uppercase;letter-spacing:0;}.ds-play-midday:hover{background:#155f80}.ds-play-midday:focus-visible{outline:4px solid #1b1430;outline-offset:4px}.ds-play-midday:active{transform:translate(4px,4px);box-shadow:none}"
    },
    {
      "name": "Fischdex Window (dusk)",
      "kind": "card",
      "refersTo": "dex-window-dusk",
      "description": "RPG dialog window holding one catch: double pixel rule, name, label grid.",
      "html": "<div class=\"ds-dex-dusk\"><h3>FISHFETCH</h3><dl><dt style=\"color:#c7b8e0\">NO.</dt><dd style=\"color:#ffd36b\">002</dd><dt style=\"color:#c7b8e0\">TYPE</dt><dd>CLI</dd><dt style=\"color:#c7b8e0\">LANG</dt><dd>PYTHON</dd></dl></div>",
      "css": ".ds-dex-dusk{background:#1b1430;color:#f4ecd8;width:100%;max-width:560px;padding:28px;box-sizing:border-box;border:4px solid #f4ecd8;outline:4px solid #6b5a9a;outline-offset:-12px;border-radius:0;font-family:'Press Start 2P',ui-monospace,monospace;text-transform:uppercase;letter-spacing:0;}.ds-dex-dusk h3{margin:0 0 18px;font-size:24px;font-weight:400;line-height:1}.ds-dex-dusk dl{display:grid;grid-template-columns:7ch auto;gap:10px 0;margin:0;font-size:14px}.ds-dex-dusk dt{opacity:1}.ds-dex-dusk dd{margin:0}"
    },
    {
      "name": "Fischdex Window (midday)",
      "kind": "card",
      "refersTo": "dex-window-midday",
      "description": "The same window in the midday light: cream panel, ink outer rule, khaki inner rule.",
      "html": "<div class=\"ds-dex-midday\"><h3>CYBERHOME</h3><dl><dt style=\"color:#4a3f63\">NO.</dt><dd style=\"color:#c4541a\">003</dd><dt style=\"color:#4a3f63\">TYPE</dt><dd>LAUNCHER</dd><dt style=\"color:#4a3f63\">LANG</dt><dd>JAVA</dd></dl></div>",
      "css": ".ds-dex-midday{background:#f4ecd8;color:#1b1430;width:100%;max-width:560px;padding:28px;box-sizing:border-box;border:4px solid #1b1430;outline:4px solid #b8a98a;outline-offset:-12px;border-radius:0;font-family:'Press Start 2P',ui-monospace,monospace;text-transform:uppercase;letter-spacing:0;}.ds-dex-midday h3{margin:0 0 18px;font-size:24px;font-weight:400;line-height:1}.ds-dex-midday dl{display:grid;grid-template-columns:7ch auto;gap:10px 0;margin:0;font-size:14px}.ds-dex-midday dt{opacity:1}.ds-dex-midday dd{margin:0}"
    },
    {
      "name": "Label Grid",
      "kind": "custom",
      "refersTo": "",
      "description": "KEY / VALUE fact rows with a fixed seven-character key column; NO. value in the accent.",
      "html": "<dl class=\"ds-labels\"><dt>NO.</dt><dd class=\"ds-no\">001</dd><dt>WHERE</dt><dd>FISCH.ING</dd><dt>NEEDS</dt><dd>NO ACCOUNT,</dd><dt></dt><dd>NO INSTALL</dd></dl>",
      "css": ".ds-labels{display:grid;grid-template-columns:7ch auto;row-gap:12px;margin:0;padding:24px;background:#1b1430;font-size:16px;font-family:'Press Start 2P',ui-monospace,monospace;text-transform:uppercase;letter-spacing:0;}.ds-labels dt{color:#c7b8e0}.ds-labels dd{margin:0;color:#f4ecd8}.ds-labels .ds-no{color:#ffd36b}"
    },
    {
      "name": "Sprite Plate",
      "kind": "custom",
